# Merge supplied fields into the active bringup file. The robot must be
# restarted to load changed configuration; success means the file was saved.
# Uses the same path resolution and partial YAML format as the check service.
string rsap_path
string file_path_override

# Optional fields as YAML text. When set, rsap_path and file_path_override
# are ignored and no requirement file is read.
string configuration_yaml
---
bool success
string message
