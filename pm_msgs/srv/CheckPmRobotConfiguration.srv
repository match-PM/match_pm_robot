# Check requirements against both the launch snapshot and the current file.
# Also returns false if the complete file differs from the launch snapshot.
# Directory containing the default pm_robot_configuration.yaml requirement file.
string rsap_path

# Optional alternative file. Relative paths are resolved below rsap_path;
# absolute paths are used directly. Leave empty to use the default filename.
string file_path_override
---
bool success
string message
